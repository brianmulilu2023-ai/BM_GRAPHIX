# BM Graphix - Supabase Configuration
# Copy these to Vercel Environment Variables (Settings → Environment Variables)

# Your Supabase project URL (from: supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (from: supabase.com → Project Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
